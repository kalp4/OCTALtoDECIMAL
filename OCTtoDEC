import java.util.Scanner;

public class OtoD {
    public static void main(String[] args) {
        Scanner in = new Scanner(System.in);
        
        System.out.print("ENTER ROW SIZE M=");
        int M = in.nextInt();
        System.out.print("ENTER COLUMN SIZE N=");
        int N = in.nextInt();
        
        // Check boundaries: M > 0 and M < 10, N > 2 and N < 6
        if (M <= 0 || M >= 10 || N <= 2 || N >= 6) {
            System.out.println("OUT OF RANGE");
            return; 
        }
        
        int[][] mat = new int[M][N];
        
        for (int i = 0; i < M; i++) {
            System.out.print("ENTER ELEMENTS FOR ROW " + (i + 1) + ": ");
            for (int j = 0; j < N; j++) {
                mat[i][j] = in.nextInt();
                
                // Digits must be strictly between 0 and 7
                if (mat[i][j] < 0 || mat[i][j] > 7) {
                    System.out.println("INVALID INPUT");
                    return; 
                }
            }
        }
        
        System.out.println("FILLED MATRIX   DECIMAL EQUIVALENT");
        for (int i = 0; i < M; i++) {
            int octal = 0; 
            for (int j = 0; j < N; j++) {
                System.out.print(mat[i][j] + " ");
                
                // Horner's Method: Multiply by 8 and add the current digit
                octal = octal * 8 + mat[i][j];
            }
            System.out.println("      " + octal);
        }
    }

    /*
    +-------------------------------------------------------------------------+
    |                       VARIABLE DESCRIPTION TABLE                        |
    +---------------+-----------+---------------------------------------------+
    | Variable Name | Data Type | Description / Purpose                       |
    +---------------+-----------+---------------------------------------------+
    | in            | Scanner   | Object used to accept input from the console|
    | M             | int       | Stores the number of rows of the matrix     |
    | N             | int       | Stores the number of columns of the matrix  |
    | mat           | int[][]   | 2D array to store the digits (0-7)          |
    | i             | int       | Loop control variable for iterating rows    |
    | j             | int       | Loop control variable for iterating columns |
    | octal         | int       | Stores the calculated decimal equivalent of |
    |               |           | the octal row using Horner's method         |
    +---------------+-----------+---------------------------------------------+
    */
}

